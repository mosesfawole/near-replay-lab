# Use disposable isolated native NEAR testnet accounts. Never use an existing wallet.
NEAR_NETWORK_ID=testnet
NEAR_TESTNET_ACCOUNT_ID=replace-disposable-owner.testnet
NEAR_TESTNET_PRIVATE_KEY=ed25519:REPLACE_WITH_DISPOSABLE_TESTNET_PRIVATE_KEY
NEAR_TESTNET_RECIPIENT_ID=replace-disposable-recipient.testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# 0.001 NEAR, expressed exactly in yoctoNEAR.
NEAR_AMOUNT_YOCTO=1000000000000000000000
NEAR_REPORT_PATH=reports/local/legitimate-transfer.json

# Fixture suite: generated private keys must stay in ignored .local/.
NEAR_SETUP_PATH=.local/testnet-setup.json
NEAR_UNSAFE_WASM_PATH=res/unsafe_vault.wasm
NEAR_GUARDED_WASM_PATH=res/guarded_vault.wasm
# 2 NEAR per fixture covers ~148 KB of code storage plus state/payments.
NEAR_FIXTURE_FUNDING_YOCTO=2000000000000000000000000
# 0.01 NEAR per dedicated keyless recipient.
NEAR_RECIPIENT_FUNDING_YOCTO=10000000000000000000000
# 2 NEAR virtual gas-spending allowance per restricted worker; no extra transfer.
# Pays keep 100 Tgas, whose protocol purchase floor can exceed the block gas price.
NEAR_WORKER_ALLOWANCE_YOCTO=2000000000000000000000000

# npm install
# npm run build:runner
# npm run cli -- transfer
# npm run cli -- inspect reports/local/legitimate-transfer.json
# For a fresh checkout without .env: npm run cli -- bootstrap
# Local Wasm/funding validation: node dist/packages/runner/src/cli.js setup --check
# npm run cli -- setup
# Set NEAR_REPORT_PATH=reports/local/fixture-suite.json before running the suite.
# npm run cli -- suite
# npm run cli -- verify reports/local/fixture-suite.json guarded
# See docs/suite.md for full PowerShell/POSIX reproduction and exact exit codes.
